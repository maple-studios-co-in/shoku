# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Database — Postgres (Prisma schema provider is `postgresql`).
# Local dev: run a Postgres and point here, e.g.:
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shoku"
# Production: a managed Postgres (Neon / Supabase / RDS) connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shoku"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
# Generate a strong secret: `openssl rand -base64 32`
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# Canonical site URL — used as metadataBase for OG/Twitter link previews.
NEXT_PUBLIC_SITE_URL="https://getshoku.com"

# Encryption-at-rest for stored café AI keys (AES-256-GCM). REQUIRED in production
# before any café stores its own AI key. Any long passphrase; rotate by re-encrypting.
#   openssl rand -base64 32
# KEY_ENCRYPTION_KEY="replace-with-a-long-random-passphrase"

# Multi-tenant
BASE_DOMAIN="shoku.maplestudios.co.in"
NEXT_PUBLIC_BASE_DOMAIN="shoku.maplestudios.co.in"
DEFAULT_TENANT_SLUG="cbtl"
# Set this ONLY in production once café subdomains are live, to share the login
# session across *.shoku… subdomains. Leave unset for local/single-host.
# COOKIE_DOMAIN=".shoku.maplestudios.co.in"

# Payments (Razorpay). Without keys, the direct checkout falls back to: in DEV it
# mock-marks orders "paid"; in PRODUCTION it places them "pending" (pay at counter)
# so a misconfigured gateway never gives away free orders. Set ALLOW_MOCK_CHECKOUT=1
# to force mock-paid in production (only if you trust pay-at-counter and want points).
# ALLOW_MOCK_CHECKOUT="0"
# Set all three to enable real online payments:
#   1. Keys from the Razorpay Dashboard → Settings → API Keys
#   2. Webhook secret from Dashboard → Webhooks (point it at
#      https://<your-host>/api/payments/razorpay/webhook, events: payment.captured, payment.failed)
# RAZORPAY_KEY_ID="rzp_test_xxxxxxxx"
# RAZORPAY_KEY_SECRET="your-razorpay-key-secret"
# RAZORPAY_WEBHOOK_SECRET="your-webhook-secret"
