{
  "name": "pista",
  "version": "0.1.0",
  "private": true,
  "description": "Pista — AI-powered white-label ordering app for cafes & restaurant chains",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "seed": "node prisma/seed.js",
    "setup": "prisma db push && node prisma/seed.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "marked": "^12.0.2",
    "next": "^15.5.22",
    "next-auth": "^4.24.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sanitize-html": "^2.17.5"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.19",
    "postcss": "^8.5.23",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.6",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "sharp": "^0.35.3",
    "postcss": "$postcss"
  }
}
